# Copy to `.env` and fill in real values (never commit `.env`).

PORT=5000
JWT_SECRET=
# Use a strong random JWT secret and keep it stable across deployments.
MONGO_URI=

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks → add URL: POST https://<your-host>/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=

# Optional: create the admin automatically when the backend starts.
# Existing accounts and passwords are preserved. Set real values only in .env.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@vadi.app
# Use a unique password: 12+ characters, maximum 72 UTF-8 bytes.
ADMIN_PASSWORD=

# Enable dedicated password-protected Play review accounts after seeding.
ENABLE_REVIEW_ACCOUNTS=false
# Optional password overrides (16+ characters); otherwise seed generates random local credentials.
# REVIEW_USER_PASSWORD=
